# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Office server connection via Cloudflare tunnel.
# Set BACKEND_URL and MEDIAMTX_URL to the tunnel URL.
# Set KEEP_PROXY_PREFIX=true so /api and /hls prefixes are kept intact for nginx routing.
BACKEND_URL="https://YOUR-TUNNEL.trycloudflare.com"
MEDIAMTX_URL="https://YOUR-TUNNEL.trycloudflare.com"
KEEP_PROXY_PREFIX="true"

# Baked into the Vite frontend build — full API base URL including /api
VITE_API_URL="https://YOUR-TUNNEL.trycloudflare.com/api"
