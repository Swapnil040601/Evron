APP_URL="http://34.93.61.112:5193"
PORT=5193

# GCP local backend — postgres + fastify run on the same GCP VM, no tunnel needed
BACKEND_URL="http://backend:3000"
MEDIAMTX_URL="http://localhost:8888"
KEEP_PROXY_PREFIX="false"

# VITE_API_URL is baked into the frontend bundle at build time.
#
# For Docker/GCP web build: set to "" so the frontend falls back to
#   window.location.origin/api and routes through the server.ts proxy.
#   Pass as build arg: docker build --build-arg VITE_API_URL="" .
#
# For Android APK build: set to the GCP public URL so the APK calls
#   the backend directly (window.location.origin = capacitor://localhost on device).
VITE_API_URL="http://34.93.61.112:5193/api"
